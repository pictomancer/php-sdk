{
    "name": "pictomancer/pictomancer",
    "description": "PHP SDK for Pictomancer.ai - agent-native image optimization API.",
    "type": "library",
    "keywords": [
        "image",
        "optimization",
        "webp",
        "avif",
        "resize",
        "compress",
        "pictomancer"
    ],
    "homepage": "https://pictomancer.ai",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Pictomancer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pictomancer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
